# Copy this file to .env and adjust as needed.
# Do not commit a real .env with production secrets.

# --- Database ---------------------------------------------------------
# Used by the backend container / local `alembic`/`uvicorn` runs.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/helpdesk

# --- API ----------------------------------------------------------------
API_PORT=8000

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins, or "*" for all
# (development only - restrict this in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (if/when a frontend is added) --------------------------------
FRONTEND_PORT=5173
